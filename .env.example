# ============================================
# CamiaCasa ABM - Environment Variables Template
# Copy this to .env and fill in your values
# ============================================

# App
NODE_ENV=development
PORT=3001
APP_URL=http://localhost:5173
API_URL=http://localhost:3001
JWT_SECRET=your_jwt_secret_here

# Database - LOCAL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=camiacasa_abm

# Database - PRODUCTION (DigitalOcean)
# DB_HOST=your_do_db_host
# DB_PORT=25060
# DB_USER=doadmin
# DB_PASS=your_do_db_password
# DB_NAME=defaultdb
# DB_SSL=true

# AI APIs
GEMINI_API_KEY=your_gemini_key
PERPLEXITY_API_KEY=your_perplexity_key

# Email & Scraping
RESEND_API_KEY=your_resend_key
FIRECRAWL_API_KEY=your_firecrawl_key

# OVH Email (IMAP reply detection)
OVH_IMAP_HOST=pro3.mail.ovh.net
OVH_IMAP_PORT=993
OVH_SMTP_HOST=pro3.mail.ovh.net
OVH_SMTP_PORT=587
OVH_EMAIL=your_email@camiacasa.cat
OVH_EMAIL_PASS=your_password
