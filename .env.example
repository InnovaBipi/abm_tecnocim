# ============================================
# ABM Platform - Environment Variables Template
# Copy this to .env and fill in your values
# ============================================

# App
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d

# Database - LOCAL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=abm_tecnocim

# Database - PRODUCTION (DigitalOcean)
# DB_HOST=your_do_db_host
# DB_PORT=25060
# DB_USER=doadmin
# DB_PASS=your_do_db_password
# DB_NAME=defaultdb
# DB_SSL=true

# AI APIs (global, shared across tenants)
GEMINI_API_KEY=your_gemini_key
PERPLEXITY_API_KEY=your_perplexity_key

# Web Scraping (global, shared across tenants)
FIRECRAWL_API_KEY=your_firecrawl_key

# Email - Global Fallback (per-tenant config in DB takes priority)
RESEND_API_KEY=your_resend_key
RESEND_WEBHOOK_SECRET=your_webhook_secret
EMAIL_FROM=noreply@example.com
EMAIL_REPLY_TO=

# Note: IMAP config is now per-tenant (configured via Settings UI)
# Note: Resend API key, FROM address, and reply-to are per-tenant
#       (configured via Settings UI). The values above serve as fallbacks.
